{
  "description": "skill-maintainer hooks: nudge session-log-drafter on Stop for substantive sessions",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/skill-maintainer-maybe-draft-session-log.sh"
            ]
          }
        ]
      }
    ]
  }
}
