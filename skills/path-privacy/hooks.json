{
  "path-privacy": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/path-privacy-session-start.sh",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/path-privacy-pre-tool-use.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
